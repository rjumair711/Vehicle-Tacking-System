# Copy to .env (local) or set in Vercel / Render. Never commit real values.

DATABASE_URL=postgresql://user:password@host/db?sslmode=require
JWT_SECRET=change-me
BACKEND_URL=https://your-service.onrender.com
RESEND_API_KEY=
RESET_EMAIL_FROM=
APP_URL=http://localhost:3000

TRIP_TIME_ZONE=Asia/Karachi
NEXT_PUBLIC_TRIP_TIME_ZONE=Asia/Karachi

# --- Trip road matching (OSRM) ---------------------------------------------
# Your own OSRM server (preferred). Leave empty to use the option below.
OSRM_MATCH_BASE_URL=

# Use the free public OSRM demo server (router.project-osrm.org), also in
# production. It is free but rate-limited (the app throttles to 1 request/s),
# has no uptime guarantee, and sends trip coordinates to a third-party demo
# server. Without this flag (or OSRM_MATCH_BASE_URL), production shows the raw
# GPS trace. Development uses the demo server automatically.
ALLOW_PUBLIC_OSRM=false

# Optional tuning / debugging
# OSRM_MAX_MATCH_COORDS=85
# OSRM_MAX_MATCH_RADIUS=
# TRIP_MATCH_DEBUG=1
